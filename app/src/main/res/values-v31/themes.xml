<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ splash screen theme attributes. On cold start, the system
     renders a splash with Void (black) background and the Kuira shield
     icon. Once the app draws, the splash exits automatically.

     Phase 2 (MaterializeEffect handoff) requires core-splashscreen
     library for installSplashScreen() — deferred to T1-7 implementation.
     This gives us branded cold-start for free. -->
<resources>
    <style name="Theme.Kuira" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">#000000</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
