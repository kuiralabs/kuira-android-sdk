<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules (API 31+).
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes

    Excluded from both cloud backup and device-to-device transfer:
    - kuira_seed.bin / .tmp — encrypted with device-bound Keystore key,
      undecryptable on a different device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="kuira_seed.bin" />
        <exclude domain="file" path="kuira_seed.bin.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="kuira_seed.bin" />
        <exclude domain="file" path="kuira_seed.bin.tmp" />
    </device-transfer>
</data-extraction-rules>
