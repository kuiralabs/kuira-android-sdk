<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules (API 23-30).
    See https://developer.android.com/guide/topics/data/autobackup

    Excluded from backup:
    - kuira_seed.bin / .tmp — encrypted seed, but encrypted with a
      device-bound Keystore key. Backing up would produce an
      undecryptable blob on restore (key doesn't transfer).
      Cross-device recovery uses a separate backup layer.
-->
<full-backup-content>
    <exclude domain="file" path="kuira_seed.bin" />
    <exclude domain="file" path="kuira_seed.bin.tmp" />
</full-backup-content>
