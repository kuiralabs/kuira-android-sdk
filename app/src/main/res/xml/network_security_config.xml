<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy for the Kuira wallet.

  Default policy: HTTPS required for all network traffic. This is
  stricter than Android's default (which allows cleartext in debug
  builds but blocks it in release) and matches what Play Store
  expects from a financial app.

  Exception: localhost targets. Cleartext is allowed ONLY for:
    - 127.0.0.1       — physical-device local services via `adb reverse`
    - 10.0.2.2        — Android emulator alias for the host machine
    - localhost       — same-origin loopback

  This covers the UNDEPLOYED (localnet) network configuration where
  the wallet talks to the developer's Docker compose services on the
  host. Preprod / Preview / Mainnet all use HTTPS per NetworkConfig
  and are not affected.

  Remove the cleartext exception for any release that ships to users
  on Preprod or Mainnet — the release APK should not need it in
  production. For v1.0 we keep it so the "developer audience" can
  run the app against their own localnet.
-->
<network-security-config>
    <!-- Default: HTTPS only, matches Android's production default. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Explicit exception for localhost-style hosts. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
