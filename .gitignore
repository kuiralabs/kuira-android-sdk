# Release signing — production keystore must NEVER be committed.
# T1-14 sets this up; live copy lives outside the repo (password manager).
/release.keystore
release.keystore
*.jks
*.keystore

# Separate repos with own git tracking
docs/security/

# Kicks example — its own independent git repo (github.com/nel349/midnight-kicks),
# not tracked by this repo. Carries ~265MB of Unity source art that doesn't
# belong in the SDK history; consumes the SDK via Maven like any external dApp.
examples/midnight-kicks/
.claude/scheduled_tasks.lock
gradle.properties

# Scratch docs-preview screenshots from mkdocs review sessions.
.preview-*.png

# Internal docs live in the private kuira-android-docs repo
/docs/

# Per-developer agent tooling. Everyone drives this repo with a different
# assistant, so nobody's configuration is forced on anyone else.
.agents/
.codex/

# Codex's context file. Deliberately NOT tracked: it is a near-verbatim twin of
# the committed CLAUDE.md, so the repo keeps ONE canonical context document
# rather than two that drift. Codex only auto-loads it from the repo root, so
# it stays here locally for whoever wants it.
AGENTS.md

# Local run/CLI noise.
logs/
yaci-cli.history
