<?xml version="1.0" encoding="utf-8"?>
<!--
  Wallet foreground service + permissions (#261-264, generalizing #235). Keeps a
  backgrounded wallet operation (send / dust-registration / contract call) OR a sync
  alive. Declared in the SDK library manifest so they merge into any host that opts in
  via WalletForegroundService.attach(); hosts edit nothing. POST_NOTIFICATIONS is
  best-effort (the work still runs if denied).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Update: required for the promoted-ongoing status-bar chip
         (#235). Not a runtime permission; the user controls it in Settings. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.midnight.kuira.sdk.walletruntime.WalletForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
