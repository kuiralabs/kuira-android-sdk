<?xml version="1.0" encoding="utf-8"?>
<!--
  Dust-sync foreground service + permissions (#235). Declared in the SDK library
  manifest so they merge into any host that opts in via DustSyncService.attach();
  hosts edit nothing. POST_NOTIFICATIONS is best-effort (sync still runs if denied).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.midnight.kuira.sdk.walletruntime.DustSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
